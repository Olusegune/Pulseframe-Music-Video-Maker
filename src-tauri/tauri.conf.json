{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PULSEFRAME",
  "version": "0.1.0",
  "identifier": "com.pulseframe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PULSEFRAME",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#090B0F",
        "theme": "Dark",
        "label": "main",
        "visible": false,
        "center": true
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 720,
        "height": 405,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#05070a",
        "focus": false,
        "title": "PULSEFRAME"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pulseframe"
        ],
        "name": "PULSEFRAME.Project",
        "description": "PULSEFRAME music video project",
        "role": "Editor",
        "mimeType": "application/x-pulseframe"
      }
    ],
    "resources": {
      "icons/document.ico": "document.ico",
      "../analysis/pulseframe_analysis/*.py": "engine/pulseframe_analysis/",
      "../analysis/pulseframe_analysis/styles.json": "engine/pulseframe_analysis/styles.json",
      "../analysis/requirements-engine.txt": "engine/requirements-engine.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "Direct music into motion.",
    "publisher": "PULSEFRAME"
  }
}